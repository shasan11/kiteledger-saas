# These are pre-install defaults only. The web installer (/install) rewrites
# this file with APP_ENV=production and APP_DEBUG=false once setup completes,
# so leave debug ON here — it makes any setup error visible instead of a blank
# 500 page. APP_KEY is intentionally empty so each install generates its own.
APP_NAME=KiteLedger
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Hosts that serve the marketing site + /admin panel (comma separated).
CENTRAL_DOMAINS=example.com,www.example.com
TENANT_BASE_DOMAIN=example.com
# Suffix appended to each tenant subdomain: acme -> acme.<TENANT_BASE_DOMAIN>.
# For wildcard subdomains in production, point *.<domain> DNS at this app and set
# SAAS_BASE_DOMAIN=yourdomain.com. See docs/WILDCARD_DOMAIN_SETUP.md.
SAAS_BASE_DOMAIN=example.com
CENTRAL_ADMIN_PATH=superadmin
TRUSTED_PROXY_IPS=

# Full demo data is CLI-only. Normal database seeding always remains
# production-safe; use kiteledger:seed-demo explicitly for sample records.
# Optional CA bundle for Stripe, PayPal, and Razorpay HTTPS requests.
# PAYMENT_GATEWAY_CA_BUNDLE=/absolute/path/to/cacert.pem
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# The web installer (/install) writes these values for you.
DB_CONNECTION=central
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kiteledger
DB_USERNAME=root
DB_PASSWORD=

# Pool mode uses pre-created tenant databases and does not require CREATE DATABASE.
# Automatic mode requires the configured DB user to pass a real CREATE/DROP probe.
TENANT_DB_PROVISIONING_MODE=manual
TENANT_DATABASE_PROVISIONING_MODE=manual
TENANT_DATABASE_PREFIX=tenant_
TENANT_DB_PREFIX=cpuser_klt_
TENANT_DB_SUFFIX=
TENANT_DB_TEMPLATE_CONNECTION=tenant_template
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=
TENANT_DB_ADMIN_HOST=127.0.0.1
TENANT_DB_ADMIN_USERNAME=
TENANT_DB_ADMIN_PASSWORD=
TENANT_ALLOW_DATABASE_DELETION=false
TENANT_PROVISIONING_LOCK_TTL=1800
TENANT_PROVISIONING_QUEUE=provisioning
TENANT_PROVISION_SYNC=false
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_DATABASE_USER=
CPANEL_DATABASE_PASSWORD=
CPANEL_DATABASE_PREFIX=

INSTALLER_LICENSE_VALIDATION_ENABLED=false
INSTALLER_LICENSE_VALIDATION_ENDPOINT=

CENTRAL_ADMIN_NAME="KiteLedger Super Admin"
CENTRAL_ADMIN_EMAIL=admin@kiteledger.test
CENTRAL_ADMIN_PASSWORD=
SAAS_BILLING_CURRENCY=USD
SAAS_SEED_DEMO_TENANT=false

SESSION_DRIVER=file
SESSION_CONNECTION=central
TENANT_SESSION_COOKIE_PREFIX=kiteledger-tenant-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
# Keep this null for wildcard tenancy. A dotted domain (e.g. .yourdomain.com)
# shares cookies across ALL tenant subdomains and breaks tenant isolation.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_DISK=local
QUEUE_CONNECTION=central
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_RETRY_AFTER=330
CACHE_STORE=file
DB_CACHE_CONNECTION=mysql
DB_CACHE_LOCK_CONNECTION=mysql

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Leave blank so the frontend resolves storage/asset URLs relative to this
# domain — works on root domains, subfolders and CDNs alike. Only set this
# if the API is served from a different origin than the frontend.
VITE_APP_BACKEND_URL=

PRISM_REQUEST_TIMEOUT=120
AI_SSL_VERIFY=true

# Optional environment fallback. The encrypted key saved in Central Admin
# Platform Settings > AI takes priority when present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# KiteLedger Copilot (provider credentials remain centrally managed)
AI_COPILOT_ENABLED=true
AI_COPILOT_ENGINE=neuron
AI_COPILOT_READ_ONLY=false
AI_RAG_ENABLED=true
AI_FINANCIAL_TOOLS_ENABLED=true
AI_WRITE_ACTIONS_ENABLED=false
AI_ACTION_EXECUTION_ENABLED=false
AI_ACTION_TTL_MINUTES=30
AI_DEBUG_ENABLED=false
AI_INCREMENTAL_INDEXING_ENABLED=true
AI_COPILOT_HISTORY_MESSAGES=20
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=
AI_RAG_TOP_K=8
AI_RAG_CANDIDATE_POOL=800
AI_RAG_MAX_CANDIDATE_POOL=2000
AI_RAG_MIN_VECTOR_SCORE=0.05
AI_RAG_CONTEXT_MAX_CHARS=12000
AI_CACHE_ENABLED=true
AI_CACHE_TTL=600
